---
const { t } = Astro.props;
---

<section id="about" class="relative py-20 md:py-28 bg-gray-50">

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">

    <!-- LEFT -->
    <div>
      <h2 class="text-3xl font-bold text-gray-900">
        {t.about.title}
      </h2>

      <div class="w-12 h-[3px] bg-yellow-400 mt-3 mb-6"></div>

      <p class="text-gray-600 mb-4">
        {t.about.desc1}
      </p>

      <p class="text-gray-600 mb-6">
        {t.about.desc2}
      </p>

      <a href="#contact" class="btn-outline">
        {t.about.btn} →
      </a>
    </div>

    <!-- RIGHT -->
    <div class="perspective">

      <div class="premium-card px-6 py-8 md:p-10">

        <h3 class="text-xl font-semibold mb-8 text-center">
          {t.about.whyTitle}
        </h3>

        <!-- GRID -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">

          <!-- ITEM 1 -->
          <div class="why-item flex flex-col items-center text-center">
            <div class="icon-animated green flex justify-center mb-4 relative">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 3l7 4v5c0 5-3.5 9-7 10-3.5-1-7-5-7-10V7l7-4z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>

            <h4 class="text-lg font-semibold">
              {t.about.why1Title}
            </h4>

            <p class="text-sm text-gray-300 mt-2">
              {t.about.why1Desc}
            </p>
          </div>

          <!-- ITEM 2 -->
          <div class="why-item flex flex-col items-center text-center">
            <div class="icon-animated gold flex justify-center mb-4 relative">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="7" r="4"/>
                <path d="M5.5 21a6.5 6.5 0 0 1 13 0"/>
              </svg>
            </div>

            <h4 class="text-lg font-semibold">
              {t.about.why2Title}
            </h4>

            <p class="text-sm text-gray-300 mt-2">
              {t.about.why2Desc}
            </p>
          </div>

          <!-- ITEM 3 -->
          <div class="why-item flex flex-col items-center text-center">
            <div class="icon-animated green flex justify-center mb-4 relative">
              <svg viewBox="0 0 24 24">
                <path d="M3 17l6-6 4 4 7-7"/>
                <path d="M14 5h7v7"/>
              </svg>
            </div>

            <h4 class="text-lg font-semibold">
              {t.about.why3Title}
            </h4>

            <p class="text-sm text-gray-300 mt-2">
              {t.about.why3Desc}
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>