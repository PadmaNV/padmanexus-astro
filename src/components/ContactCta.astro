---
const { t } = Astro.props;
---

<section id="contact" class="py-24 bg-gradient-to-r from-[#0f5132] to-[#0a1f3d] text-white">

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">

    <!-- LEFT -->
    <div>
      <div class="w-10 h-[3px] bg-yellow-400 mb-6"></div>

      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        {t.contactCta.title}
      </h2>

      <p class="text-gray-200 text-lg max-w-md">
        {t.contactCta.desc}
      </p>
    </div>

    <!-- RIGHT -->
    <div>
      <form 
        action="https://formsubmit.co/info@padmanexus.com" 
        method="POST"
        class="bg-white/10 backdrop-blur-xl p-6 md:p-8 rounded-2xl space-y-4 shadow-xl"
      >

        <!-- Anti-spam -->
        <input type="hidden" name="_captcha" value="false">

        <input 
          type="text" 
          name="name" 
          placeholder={t.contactCta.name}
          required
          class="w-full p-3 rounded-lg bg-white/90 text-black placeholder-gray-500"
        />

        <input 
          type="email" 
          name="email" 
          placeholder={t.contactCta.email}
          required
          class="w-full p-3 rounded-lg bg-white/90 text-black placeholder-gray-500"
        />

        <textarea 
          name="message" 
          placeholder={t.contactCta.message}
          rows="3"
          required
          class="w-full p-3 rounded-lg bg-white/90 text-black placeholder-gray-500"
        ></textarea>

        <button class="btn-primary w-full">
          {t.contactCta.button} →
        </button>

      </form>
    </div>

  </div>

</section>