---
const { t } = Astro.props;
---

<section id="hero" class="scroll-mt-24 relative h-auto md:h-[500px] py-16 md:py-0 flex items-center text-white overflow-hidden">

  <!-- BG -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#0a1f3d] via-[#0c2b4f] to-[#0f5132]"></div>

  <!-- LIGHT -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(34,197,94,0.22),transparent_45%)]"></div>

  <div class="relative max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center w-full">

    <!-- LEFT -->
    <div class="max-w-lg text-center md:text-left">

      <!-- badge -->
      <p class="text-yellow-400 font-semibold mb-3 text-sm tracking-wide">
        {t.hero.badge}
      </p>

      <!-- TITLE (з переносом як було) -->
      <h1 class="text-[32px] md:text-[54px] font-bold leading-[1.1]">
        {t.hero.title1}<br />
        {t.hero.title2.split(' ')[0]}
        <span class="text-yellow-400">
          {' ' + t.hero.title2.split(' ').slice(1).join(' ')}
        </span>
      </h1>

      <!-- DESC -->
      <p class="text-gray-300 mt-5 text-[15px] md:text-[18px] leading-[1.8]">
        {t.hero.desc}
      </p>

      <!-- BUTTONS -->
      <div class="flex flex-col md:flex-row gap-4 mt-8 md:mt-12">
        <a href="#services" class="btn-primary">
          {t.hero.btnServices} →
        </a>

        <a href="#contact" class="btn-outline">
          {t.hero.btnContact}
        </a>
      </div>

    </div>

    <!-- RIGHT -->
    <div id="hero-visual" class="relative flex justify-center items-center h-full mt-10 md:mt-0">

      <!-- CORE -->
      <div class="energy-core"></div>

      <!-- RIPPLE -->
      <div class="ripple big"></div>
      <div class="ripple medium"></div>

      <!-- ORBITS (збільшено кількість точок) -->
      <div class="orbit orbit-1">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>

      <div class="orbit orbit-2">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span>
      </div>

      <!-- PARTICLES (розкид зірок) -->
      <div class="particles-ultra">
        <span style="top:10%; left:15%"></span>
        <span style="top:20%; left:80%"></span>
        <span style="top:70%; left:10%"></span>
        <span style="top:60%; left:85%"></span>
        <span style="top:30%; left:50%"></span>
        <span style="top:80%; left:60%"></span>
        <span style="top:15%; left:65%"></span>
        <span style="top:75%; left:40%"></span>
        <span style="top:45%; left:5%"></span>
        <span style="top:50%; left:95%"></span>
      </div>

      <!-- LOGO -->
      <img 
        src="/big_logo_Padma_Nexus.png"
        class="logo-ultra w-[300px] md:w-[700px] relative z-10"
        alt="Padma Nexus"
      />

    </div>

  </div>

</section>

<script>
  const hero = document.getElementById('hero');
  const visual = document.getElementById('hero-visual');

  if (hero && visual && window.innerWidth > 768) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();

      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      visual.style.transform = `
        translate(${x * 20}px, ${y * 25}px)
        rotateX(${y * -10}deg)
        rotateY(${x * 10}deg)
      `;
    });

    hero.addEventListener('mouseleave', () => {
      visual.style.transform = `translate(0,0) rotateX(0) rotateY(0)`;
    });
  }
</script>