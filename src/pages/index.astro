---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- HERO -->
  <section id="hero" class="relative h-auto md:h-[500px] py-16 md:py-0 flex items-center text-white overflow-hidden">

    <!-- BG -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1f3d] via-[#0c2b4f] to-[#0f5132]"></div>

    <!-- LIGHT -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(34,197,94,0.22),transparent_45%)]"></div>

    <div class="relative max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center w-full">

      <!-- LEFT -->
      <div class="max-w-lg text-center md:text-left">

        <div class="-mt-6 md:-mt-10">

          <p class="text-yellow-400 font-semibold mb-3 text-sm tracking-wide">
            IT, DATA PROCESSING & BUSINESS CONSULTING
          </p>

          <h1 class="text-[32px] md:text-[54px] font-bold leading-[1.1]">
            We turn data<br />
            into <span class="text-yellow-400">value.</span>
          </h1>

          <p class="text-gray-300 mt-5 text-[15px] md:text-[18px] leading-[1.8]">
            We help businesses optimize processes, structure data,<br class="hidden md:block" />
            and implement digital solutions that drive growth.
          </p>

        </div>

        <!-- BUTTONS -->
        <div class="flex flex-col md:flex-row gap-4 mt-8 md:mt-12">
          <button class="btn-primary">Our Services →</button>
          <button class="btn-outline">Contact Us</button>
        </div>

      </div>


      <!-- RIGHT -->
      <div id="hero-visual" class="relative flex justify-center items-center h-full mt-10 md:mt-0">

        <!-- ENERGY CORE -->
        <div class="energy-core"></div>

        <!-- RIPPLE -->
        <div class="ripple big"></div>
        <div class="ripple medium"></div>

        <!-- ORBITS -->
        <div class="orbit orbit-1">
          <span></span><span></span><span></span><span></span>
        </div>

        <div class="orbit orbit-2">
          <span></span><span></span><span></span><span></span>
        </div>

        <!-- PARTICLES -->
        <div class="particles-ultra">
          <span></span><span></span><span></span><span></span><span></span>
        </div>

        <!-- LOGO -->
        <img 
          src="/big_logo_Padma_Nexus.png"
          class="logo-ultra w-[300px] md:w-[700px] relative z-10"
          alt="Padma Nexus"
        />

      </div>

    </div>
  </section>


  <!-- SERVICES -->
  <section class="relative py-20 bg-gradient-to-b from-gray-100 to-gray-50 text-center overflow-hidden">

    <!-- subtle glow -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(34,197,94,0.08),transparent_40%)]"></div>

    <div class="relative max-w-7xl mx-auto px-6">

      <h2 class="text-3xl md:text-4xl font-bold text-gray-800">
        Our Services
      </h2>

      <div class="w-16 h-[3px] bg-green-500 mx-auto mt-3 rounded-full"></div>

      <p class="text-gray-500 mt-4 text-sm md:text-base">
        Practical solutions tailored to your business needs.
      </p>

      <!-- GRID -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mt-14">

        <!-- CARD 1 -->
        <div class="service-card group">
          <div class="icon-circle">
            <svg class="icon-animated" viewBox="0 0 24 24">
              <!-- baseline -->
              <path class="line" d="M3 20h18" />

              <!-- trend line -->
              <path class="line" d="M5 15l4-4 4 3 6-7" />

              <!-- single highlight point -->
              <circle class="node" cx="19" cy="7" r="1.8" />
            </svg>
          </div>
          <h3>Business Process Analysis</h3>
          <p>We analyze your processes and identify opportunities to improve efficiency and reduce costs.</p>
          <span class="arrow">→</span>
        </div>

        <!-- CARD 2 -->
        <div class="service-card group">
          <div class="icon-circle">
            <svg class="icon-animated" viewBox="0 0 24 24">
              <circle class="line" cx="8" cy="8" r="3" />
              <circle class="line" cx="16" cy="8" r="3" />
              <path class="line" d="M2 20c0-3 4-5 6-5s6 2 6 5" />
              <path class="line" d="M12 20c0-2 3-4 4-4s4 2 4 4" />
            </svg>
          </div>
          <h3>CRM Implementation</h3>
          <p>We help you select, implement and optimize CRM systems that fit your business.</p>
          <span class="arrow">→</span>
        </div>

        <!-- CARD 3 -->
        <div class="service-card group">
          <div class="icon-circle">
            <svg class="icon-animated" viewBox="0 0 24 24">
              <ellipse class="line" cx="12" cy="5" rx="7" ry="3" />
              <path class="line" d="M5 5v6c0 1.7 3 3 7 3s7-1.3 7-3V5" />
              <path class="line" d="M5 11v6c0 1.7 3 3 7 3s7-1.3 7-3v-6" />
              <circle class="node" cx="12" cy="14" r="1.2" />
            </svg>
          </div>
          <h3>Data Processing & Structuring</h3>
          <p>We clean, structure and transform data into valuable information for better decisions.</p>
          <span class="arrow">→</span>
        </div>

        <!-- CARD 4 -->
        <div class="service-card group">
          <div class="icon-circle">
            <svg class="icon-animated" viewBox="0 0 24 24">
              <rect class="line" x="3" y="4" width="18" height="14" rx="2" />
              <path class="line" d="M3 10h18" />
              <circle class="node" cx="7" cy="7" r="1" />
              <circle class="node" cx="11" cy="7" r="1" />
              <circle class="node" cx="15" cy="7" r="1" />
            </svg>
          </div>
          <h3>UI/UX & Web Design</h3>
          <p>We design modern, user-friendly web solutions that represent your brand professionally.</p>
          <span class="arrow">→</span>
        </div>

        <!-- CARD 5 -->
        <div class="service-card group">
          <div class="icon-circle">
            <svg class="icon-animated" viewBox="0 0 24 24">
              <!-- connection line -->
              <path class="line" d="M6 12h12" />

              <!-- left person -->
              <circle class="line" cx="8" cy="8" r="2" />
              <path class="line" d="M5 16c0-2 2-3 3-3s3 1 3 3" />

              <!-- right person -->
              <circle class="line" cx="16" cy="8" r="2" />
              <path class="line" d="M13 16c0-2 2-3 3-3s3 1 3 3" />
            </svg>
          </div>
          <h3>Business Consulting</h3>
          <p>We provide expert advice to help you grow, scale and stay competitive in your market.</p>
          <span class="arrow">→</span>
        </div>

      </div>

    </div>
  </section>

  <!-- ABOUT + WHY US (ULTRA PREMIUM) -->
<section class="relative py-28 bg-gray-50 overflow-hidden">

  <!-- subtle background effect -->
  <div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_20%_30%,rgba(34,197,94,0.08),transparent_40%)]"></div>

  <div class="relative max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-20 items-center">

    <!-- LEFT -->
    <div class="fade-in-up">

      <h2 class="text-3xl font-bold text-gray-900">
        About Padma Nexus s.r.o.
      </h2>

      <div class="w-12 h-[3px] bg-yellow-400 mt-3 mb-6"></div>

      <p class="text-gray-600 leading-relaxed mb-4">
        We are a Slovakia-based company providing IT services, data processing, and business consulting for small and medium-sized enterprises across the EU.
      </p>

      <p class="text-gray-600 leading-relaxed mb-8">
        Our mission is to help businesses make smarter decisions through data, technology, and efficient processes.
      </p>

      <button class="btn-outline hover:scale-105 transition">
        Learn more about us →
      </button>

    </div>


    <!-- RIGHT -->
    <div class="relative group perspective">

      <!-- CARD -->
      <div class="premium-card">

        <!-- glow -->
        <div class="card-glow"></div>

        <h3 class="text-xl font-semibold mb-10 relative z-10">
          Why work with us?
        </h3>

        <div class="grid grid-cols-3 gap-6 text-center relative z-10">

          <!-- ITEM -->
          <div class="why-item">
            <div class="icon-animated green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 3l7 4v5c0 5-3.5 9-7 10-3.5-1-7-5-7-10V7l7-4z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>
            <h4>Reliable & Secure</h4>
            <p>
              We follow best practices to ensure security and data protection.
            </p>
          </div>

          <!-- ITEM -->
          <div class="why-item border-x border-white/10 px-4">
            <div class="icon-animated gold">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="7" r="4"/>
                <path d="M5.5 21a6.5 6.5 0 0 1 13 0"/>
              </svg>
            </div>
            <h4>Client Focused</h4>
            <p>
              We listen, understand, and deliver solutions that fit your goals.
            </p>
          </div>

          <!-- ITEM -->
          <div class="why-item">
            <div class="icon-animated green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 17l6-6 4 4 7-7"/>
                <path d="M14 5h7v7"/>
              </svg>
            </div>
            <h4>Results Driven</h4>
            <p>
              We focus on measurable outcomes that support your growth.
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- CTA + CONTACT -->
<section class="py-20 bg-gradient-to-r from-[#0f5132] to-[#0a1f3d] text-white">

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-10 items-center">

    <!-- LEFT -->
    <div>

      <div class="w-10 h-[3px] bg-yellow-400 mb-5"></div>

      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Ready to optimize your business?
      </h2>

      <p class="text-gray-200 text-lg">
        Let's discuss how we can help you achieve your goals.
      </p>

    </div>

    <!-- RIGHT (FORM) -->
    <form 
      action="https://formsubmit.co/info@padmanexus.com" 
      method="POST"
      class="bg-white/10 backdrop-blur-lg p-6 rounded-xl space-y-4"
    >

      <!-- Anti-spam -->
      <input type="hidden" name="_captcha" value="false">

      <input 
        type="text" 
        name="name" 
        placeholder="Your Name"
        required
        class="w-full p-3 rounded-lg bg-white/90 text-black"
      />

      <input 
        type="email" 
        name="email" 
        placeholder="Your Email"
        required
        class="w-full p-3 rounded-lg bg-white/90 text-black"
      />

      <textarea 
        name="message" 
        placeholder="Your Message"
        rows="3"
        required
        class="w-full p-3 rounded-lg bg-white/90 text-black"
      ></textarea>

      <button class="btn-primary w-full">
        Get in touch →
      </button>

    </form>

  </div>

</section>

  <!-- CURSOR INTERACTION (тільки desktop) -->
  <script>
    const hero = document.getElementById('hero');
    const visual = document.getElementById('hero-visual');

    if (window.innerWidth > 768) {
      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();

        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        visual.style.transform = `
          translate(${x * 12}px, ${y * 12}px)
          rotateX(${y * -6}deg)
          rotateY(${x * 6}deg)
        `;
      });

      hero.addEventListener('mouseleave', () => {
        visual.style.transform = `translate(0,0) rotateX(0) rotateY(0)`;
      });
    }
  </script>

  <!-- FOOTER -->
<footer class="bg-gradient-to-r from-[#0a1f3d] to-[#0f5132] text-white pt-16 pb-8">

  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 lg:grid-cols-4 gap-10">

    <!-- LOGO + DESC -->
    <div>

      <img 
        src="/logo_Padma_Nexus_v3.png" 
        class="w-[160px] mb-5"
        alt="Padma Nexus"
      />

      <p class="text-gray-300 text-sm leading-relaxed">
        IT, data processing and business consulting services. 
        We help companies transform data into smart solutions.
      </p>

      <!-- SOCIALS -->
      <div class="flex gap-4 mt-6">

        <div class="footer-icon">in</div>
        <div class="footer-icon">✉</div>
        <div class="footer-icon">◎</div>

      </div>

    </div>


    <!-- QUICK LINKS -->
    <div>
      <h4 class="font-semibold mb-4">Quick Links</h4>

      <ul class="space-y-3 text-gray-300">
        <li><a href="#" class="footer-link">Home</a></li>
        <li><a href="#" class="footer-link">Services</a></li>
        <li><a href="#" class="footer-link">About</a></li>
        <li><a href="#" class="footer-link">Why Us</a></li>
        <li><a href="#" class="footer-link">Contact</a></li>
      </ul>
    </div>


    <!-- SERVICES -->
    <div>
      <h4 class="font-semibold mb-4">Services</h4>

      <ul class="space-y-3 text-gray-300">
        <li>Business Process Analysis</li>
        <li>CRM Implementation</li>
        <li>Data Processing & Structuring</li>
        <li>UI/UX & Web Design</li>
        <li>Business Consulting</li>
      </ul>
    </div>


    <!-- CONTACT -->
    <div>
      <h4 class="font-semibold mb-4">Contact</h4>

      <ul class="space-y-4 text-gray-300 text-sm">

        <li class="flex items-center gap-3">
          ✉ 
          <a 
            href="mailto:info@padmanexus.com?subject=Business Inquiry&body=Hello Padma Nexus,"
            class="footer-link"
          >
            info@padmanexus.com
          </a>
        </li>

        <li class="flex items-start gap-3">
          📍 
          <a 
            href="https://www.google.com/maps/search/?api=1&query=Saratovska+5898+841+02+Bratislava+Slovakia" 
            target="_blank"
            class="footer-link"
          >
            Saratovská 5898<br />
            841 02 Bratislava<br />
            Slovakia
          </a>
        </li>

      </ul>
    </div>

  </div>


  <!-- BOTTOM -->
  <div class="border-t border-white/10 mt-12 pt-6 flex flex-col md:flex-row justify-between items-center text-sm text-gray-400 max-w-7xl mx-auto px-6">

    <p>© 2026 Padma Nexus s.r.o. All rights reserved.</p>

    <div class="flex gap-6 mt-4 md:mt-0">
      <a href="#" class="footer-link">Privacy Policy</a>
      <a href="#" class="footer-link">Terms of Use</a>
    </div>

  </div>

</footer>

</Layout>